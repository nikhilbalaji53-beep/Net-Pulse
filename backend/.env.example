# NetPulse Configuration
PROJECT_NAME="NetPulse — Intelligent Ping Monitoring System"
VERSION="1.0.0"
ENVIRONMENT="development"

# Security & JWT
SECRET_KEY="netpulse-super-secret-production-key-change-in-production-12345678"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite default for quick start, PostgreSQL supported)
DATABASE_URL="sqlite+aiosqlite:///./netpulse.db"
# Example PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/netpulse"

# Monitoring Engine Defaults
DEFAULT_PING_INTERVAL=30
DEFAULT_TIMEOUT=5
DEFAULT_FAILURE_THRESHOLD=3
DEFAULT_RECOVERY_THRESHOLD=2

# Thresholds for classification
LATENCY_EXCELLENT_THRESHOLD=50.0
LATENCY_GOOD_THRESHOLD=100.0
LATENCY_WARNING_THRESHOLD=200.0
LATENCY_CRITICAL_THRESHOLD=500.0
PACKET_LOSS_WARNING_THRESHOLD=5.0
PACKET_LOSS_CRITICAL_THRESHOLD=20.0

# Data Retention (Days)
DATA_RETENTION_DAYS=30

# Security: Allow monitoring private IP ranges (LAN, home lab, office networks)
ALLOW_PRIVATE_IPS=true

# Email / SMTP Alerts (Optional)
SMTP_ENABLED=false
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="alerts@netpulse.local"

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]
